# Copie para .env e ajuste se necessário. Nunca versione o .env.
API_PORT=3001
WEB_PORT=3000
# DATABASE_URL e PAYMENT_GATEWAY_URL valem para rodar a API fora do docker compose;
# dentro dele, a API usa os nomes dos serviços db e mock-gateway.
DATABASE_URL=postgres://bilheteria:bilheteria@localhost:5432/bilheteria
PAYMENT_GATEWAY_URL=http://localhost:8080
POSTGRES_USER=bilheteria
POSTGRES_PASSWORD=bilheteria
POSTGRES_DB=bilheteria
POSTGRES_PORT=5432
MOCK_GATEWAY_PORT=8080
CORS_ORIGIN=http://localhost:3000
